# ============================================================================
# KAARIGAR ENVIRONMENT TEMPLATE
# Copy this file to `.env` (`cp .env.example .env`) — `.env` is gitignored!
# IMPORTANT: Never prefix secret keys with `VITE_` (Vite bundles `VITE_*` into browser JS).
# ============================================================================

# -------------------- SERVER-ONLY SECRETS (Backend `server/index.mjs`) --------------------
NODE_ENV=development
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Free India Places / Geocoding APIs (kept strictly on backend so keys never leak to browser)
# Option 1: Ola Maps (Free, no credit card) — https://maps.olakrutrim.com
OLA_MAPS_API_KEY=
# Option 2: Geoapify (Free 3,000/day, email signup, no credit card) — https://myprojects.geoapify.com
GEOAPIFY_API_KEY=

# Future Payment & Messaging Secrets (Server-only — NEVER prefix with VITE_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_ACCESS_TOKEN=

# Local Demo Seed Config (ignored automatically when NODE_ENV=production)
SEED_DEMO_DATA=true
DEMO_SEED_PIN=1234

# -------------------- PUBLIC CLIENT VARIABLES (Safe for Browser) --------------------
# Optional Supabase Cloud public client config (protected by Postgres RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional domain-restricted tile key (only if switching away from free OpenFreeMap vector tiles)
VITE_OLA_MAPS_API_KEY=

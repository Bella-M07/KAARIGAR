<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light">
<title>Kaarigar</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{color-scheme:light;--tw:549px;--th:526px;--ink:#3b1a5a;--mute:#5f5675;--vio:#7C3AED;--pink:#F43C84;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(max-width:700px){:root{--tw:330px;--th:316px}}
*{box-sizing:border-box}html,body{height:100%;margin:0}
body{background:#fff;color:var(--ink);font:16px/1.6 Poppins,system-ui,sans-serif;overflow-x:hidden}
.bg{position:fixed;inset:0;z-index:-1;background:linear-gradient(rgba(255,255,255,.4),rgba(255,255,255,.4)),url(data:image/jpeg;base64,);background-size:auto,var(--tw) var(--th);background-position:0 0,0 0;animation:drift 38s linear infinite}
@keyframes drift{to{background-position:0 0,var(--tw) var(--th)}}
.page{min-height:100%;display:flex;flex-direction:column}
nav{display:flex;justify-content:flex-end;max-width:1180px;width:100%;margin:0 auto;padding:22px 28px}
.link{font-weight:500;font-size:15px;color:var(--ink);text-decoration:none;border-bottom:2px solid var(--pink);padding-bottom:2px}
.hero{flex:1;display:grid;grid-template-columns:minmax(0,1fr);place-items:center;overflow-x:clip;text-align:center;padding:0 24px 70px;position:relative;min-height:560px}
.hero::before{content:"";position:absolute;left:50%;top:50%;width:min(900px,120vw);height:480px;transform:translate(-50%,-50%);background:radial-gradient(closest-side,rgba(255,255,255,.3),rgba(255,255,255,0));pointer-events:none}
.in{position:relative;width:100%;max-width:620px;margin:0 auto}
.in>*{opacity:0;animation:up .8s cubic-bezier(.2,.8,.2,1) forwards}
.in>:nth-child(2){animation-delay:.12s}.in>:nth-child(3){animation-delay:.26s}
@keyframes up{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
.logo{width:min(500px,82vw);height:auto;display:block;margin:0 auto}
.lead{margin:22px auto 0;max-width:34ch;font-size:15.5px;color:var(--mute);line-height:1.65}
.lead b{display:block;margin-top:6px;font-weight:600;color:var(--pink);font-size:14.5px}
.search{display:flex;gap:6px;margin:30px auto 0;max-width:520px;padding:7px;border-radius:999px;background:linear-gradient(135deg,rgba(255,255,255,.5),rgba(255,255,255,.1));backdrop-filter:blur(18px) saturate(180%);-webkit-backdrop-filter:blur(18px) saturate(180%);border:1px solid rgba(255,255,255,.75);box-shadow:0 14px 36px rgba(124,58,237,.18),inset 0 1px 0 rgba(255,255,255,.95),inset 0 -1px 0 rgba(255,255,255,.35)}
.search input{flex:1;min-width:0;border:0;background:none;padding:0 20px;font:inherit;color:var(--ink);outline:0}
.search input::placeholder{color:#6d6486}
.search:focus-within{border-color:#fff;box-shadow:0 14px 36px rgba(124,58,237,.28),0 0 0 3px rgba(124,58,237,.25),inset 0 1px 0 #fff}
.btn{border:0;border-radius:999px;padding:12px 26px;font:600 15px Poppins,sans-serif;background:var(--pink);color:#fff;cursor:pointer;transition:transform .2s,box-shadow .2s}
.btn:hover{transform:translateY(-2px);box-shadow:0 8px 18px #f43c8444}
/* animated icon tiles */
.tiles{position:absolute;inset:0;pointer-events:none}
.t{position:absolute;width:128px;animation:fl 7s ease-in-out infinite alternate}
.t svg{width:100%;display:block;overflow:visible}
@keyframes fl{from{transform:translate(-10px,10px)}to{transform:translate(10px,-10px)}}
.ln{stroke:#7a4b6e;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
.ln *{transform-box:fill-box}
.spin{transform-origin:center;animation:sp 2.6s linear infinite}@keyframes sp{to{transform:rotate(360deg)}}
.nd{animation:nd .45s ease-in-out infinite alternate}@keyframes nd{to{transform:translateY(7px)}}
.dash{stroke-dasharray:3 3;animation:da .7s linear infinite}@keyframes da{to{stroke-dashoffset:-6}}
.lid{animation:lid 2.2s ease-in-out infinite}@keyframes lid{50%{transform:translateY(-5px)}}
.bump{animation:bp 1.8s ease-in-out infinite alternate;transform-origin:50% 100%}@keyframes bp{to{transform:translateY(-3px) scale(1.04)}}
.bb{animation:bb 2.4s ease-out infinite;opacity:0}.b2{animation-delay:.8s}.b3{animation-delay:1.6s}
@keyframes bb{0%{transform:translateY(8px);opacity:0}30%{opacity:1}100%{transform:translateY(-14px);opacity:0}}
.flame{transform-origin:50% 100%;animation:fk .5s ease-in-out infinite alternate}@keyframes fk{to{transform:scale(.8,1.12)}}
.sway{transform-origin:50% 100%;animation:sw 3s ease-in-out infinite alternate}@keyframes sw{from{transform:rotate(-4deg)}to{transform:rotate(4deg)}}
.hop{animation:hp 1.3s ease-in-out infinite}@keyframes hp{50%{transform:translateY(-7px)}}
@media(max-width:480px){.search input{padding:0 12px;font-size:14.5px}.btn{padding:12px 20px}}
@media(max-width:900px){.t{width:92px}.hero{min-height:calc(100svh - 66px)}
.tiles>.t:nth-child(n){left:auto!important;right:auto!important;top:auto!important}
.tiles>.t:nth-child(1){left:3%!important;top:3%!important}
.tiles>.t:nth-child(5){left:39%!important;top:0%!important}
.tiles>.t:nth-child(4){right:3%!important;top:6%!important}
.tiles>.t:nth-child(2){left:5%!important;top:80%!important}
.tiles>.t:nth-child(6){left:39%!important;top:85%!important}
.tiles>.t:nth-child(3){right:4%!important;top:77%!important}}
:focus-visible{outline:3px solid #FFB510;outline-offset:2px}
@media(prefers-reduced-motion:reduce){.bg,.in>*,.t,.t *{animation:none!important;opacity:1}.bb{opacity:0}}
</style></head><body>
